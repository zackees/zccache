# syntax=docker/dockerfile:1.7

# Bosn-owned environment for running this repository's GitHub Actions
# workflows locally with nektos/act. act drives the *host* Docker engine
# through the bind-mounted /var/run/docker.sock, so job containers are
# siblings of this container, not children. See README.md.
FROM debian:bookworm-slim

ARG TARGETARCH
ARG ACT_VERSION=0.2.88
ARG ACT_SHA256_AMD64=1eb9996682dfcc053ac8f3f90f2ec50376f0cdfc229712d82da03d673c63a2b3
ARG ACT_SHA256_ARM64=94d87738f7ea6650782c8505366c758c99db54cc67bd8c711583478c93305d78
ARG DOCKER_CLI_VERSION=29.7.2
ARG DOCKER_CLI_SHA256_AMD64=803d433f226db4776e1768fd319fc6c6e4935a456acf84fcc0080818b854bc8f
ARG DOCKER_CLI_SHA256_ARM64=43d143448adf2c2787704e7d7704fd6d62d367a54c5edaef0a3f75509cb0938d

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git \
 && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) act_arch=x86_64; act_sha="${ACT_SHA256_AMD64}"; \
             docker_arch=x86_64; docker_sha="${DOCKER_CLI_SHA256_AMD64}" ;; \
      arm64) act_arch=arm64; act_sha="${ACT_SHA256_ARM64}"; \
             docker_arch=aarch64; docker_sha="${DOCKER_CLI_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --silent --show-error \
        "https://github.com/nektos/act/releases/download/v${ACT_VERSION}/act_Linux_${act_arch}.tar.gz" \
        -o /tmp/act.tar.gz; \
    echo "${act_sha}  /tmp/act.tar.gz" | sha256sum --check -; \
    tar -xzf /tmp/act.tar.gz -C /usr/local/bin act; \
    curl --fail --location --silent --show-error \
        "https://download.docker.com/linux/static/stable/${docker_arch}/docker-${DOCKER_CLI_VERSION}.tgz" \
        -o /tmp/docker.tgz; \
    echo "${docker_sha}  /tmp/docker.tgz" | sha256sum --check -; \
    tar -xzf /tmp/docker.tgz -C /tmp docker/docker; \
    install -m 0755 /tmp/docker/docker /usr/local/bin/docker; \
    rm -rf /tmp/act.tar.gz /tmp/docker.tgz /tmp/docker; \
    act --version; \
    docker --version

WORKDIR /work
